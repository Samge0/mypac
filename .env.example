# ============================================================
#  mypac 配置文件
#  复制本文件为 .env 并修改对应值：  cp .env.example .env
# ============================================================

# PAC 服务监听端口（本机和其他设备访问 PAC 时用的端口）
PAC_PORT=10390

# 上游代理地址（Clash / mihomo / V2Ray 等本地代理）
# 局域网设备将通过此地址连接你的代理
# 格式: IP:PORT
PROXY_TARGET=127.0.0.1:7890

# 日志保留天数（按天滚动，到期自动清理）
LOG_RETAIN_DAYS=7

# 说明：
# - 本机访问 PAC 时，会自动把 IP 降级为 127.0.0.1（走环回，更快）
# - 局域网设备访问 PAC 时，直接使用此处的 PROXY_TARGET
# - 请确保代理软件已开启「允许局域网连接 / Allow LAN」
