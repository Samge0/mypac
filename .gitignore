# mypac .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# 虚拟环境
venv/
.venv/
env/
ENV/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志与运行时
*.log
*.pid
logs/

# 运行时日志目录（按天滚动的日志写在这里）
.cache/

# 系统/临时文件
.tmp/
tmp/

# 用户配置（包含代理地址等本地信息，不入库）
.env
